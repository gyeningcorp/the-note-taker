# Personal API requests MUST provide a key in each request.
# Your Claude Pro subscription is not an Anthropic API key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Public free notes use a completely separate OpenAI billing key
PUBLIC_OPENAI_API_KEY=
FREE_NOTES_ENABLED=false
PUBLIC_NOTES_MODEL=gpt-4o-mini
# Set a stable randomly generated secret with at least 32 characters
QUOTA_HASH_SECRET=
# Persistent Railway volume at /data is required for usage counters
QUOTA_DB_PATH=/data/note-taker-quota.sqlite
CORS_ORIGIN=https://the-note-taker.vercel.app
